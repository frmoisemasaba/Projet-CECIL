<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="{{ page.description }}"
    />
    <meta name="theme-color" content="#f8f7f3" />
    <title>{{ page.title }} | {{ site.title }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="{{ asset('styles.css') }}" />
    <script>
      window.CECIL_PRODUCTS = {{ site.data.products.products|json_encode|raw }};
    </script>
    <script src="{{ asset('app.js') }}" defer></script>
  </head>
  <body>
    <div class="announcement">
      <p>Livraison offerte dès 120 € d’achat</p>
      <a href="#selection">Découvrir la collection <span aria-hidden="true">↗</span></a>
    </div>

    <header class="site-header">
      <a class="wordmark" href="#" aria-label="CECIL, accueil">CECIL<span>®</span></a>
      <nav class="main-nav" aria-label="Navigation principale">
        <a href="#selection">La boutique</a>
        <a href="#histoire">Notre histoire</a>
        <a href="#journal">Le journal</a>
      </nav>
      <div class="header-actions">
        <label class="search-box">
          <span class="sr-only">Rechercher un produit</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 4.5 4.5"></path></svg>
          <input id="search-input" type="search" placeholder="Rechercher" autocomplete="off" />
        </label>
        <button class="cart-trigger" id="open-cart" type="button" aria-label="Ouvrir le panier, 0 article">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l1 12H4L5 8Z"></path><path d="M9 9V6a3 3 0 0 1 6 0v3"></path></svg>
          <span>Panier</span>
          <span class="cart-count" id="cart-count">0</span>
        </button>
      </div>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <img
          class="hero-image"
          src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=2200&q=85"
          alt="Salon lumineux aux matières naturelles et aux tons doux"
        />
        <div class="hero-shade"></div>
        <div class="hero-content">
          <p class="eyebrow hero-eyebrow">Objets choisis, maisons habitées</p>
          <h1 id="hero-title">La beauté<br />des jours simples.</h1>
          <p>Des pièces durables et sensibles, pour faire de chez soi un endroit à part.</p>
          <a class="button button-light" href="#selection">Explorer la collection <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-caption"><span>01 — 03</span><span>Collection automne · 2026</span></div>
      </section>

      <section class="intro" id="histoire" aria-label="Notre approche">
        <p class="eyebrow">L’art d’habiter</p>
        <p class="intro-copy">Moins, mais mieux. Des objets qui traversent les saisons et racontent un peu de vous.</p>
        <a class="text-link" href="#journal">En savoir plus <span aria-hidden="true">↗</span></a>
      </section>

      <section class="shop-section" id="selection" aria-labelledby="shop-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">La sélection CECIL</p>
            <h2 id="shop-title">Pour se sentir chez soi.</h2>
          </div>
          <a class="text-link all-products-link" href="#products">Voir toute la collection <span aria-hidden="true">↗</span></a>
        </div>
        <div class="shop-toolbar">
          <div class="filters" role="group" aria-label="Filtrer les produits">
            <button class="filter-button is-active" type="button" data-filter="Tous">Tout voir</button>
            <button class="filter-button" type="button" data-filter="Décoration">Décoration</button>
            <button class="filter-button" type="button" data-filter="Art de la table">Art de la table</button>
            <button class="filter-button" type="button" data-filter="Textiles">Textiles</button>
            <button class="filter-button" type="button" data-filter="Luminaires">Luminaires</button>
          </div>
          <p class="result-count" id="result-count" aria-live="polite"></p>
        </div>
        <div class="product-grid" id="products"></div>
        <p class="empty-results" id="empty-results" hidden>Aucun produit ne correspond à votre recherche.</p>
      </section>

      <section class="story" id="journal" aria-labelledby="story-title">
        <div class="story-image-wrap">
          <img
            src="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&w=1200&q=85"
            alt="Intérieur chaleureux décoré de pièces artisanales"
            loading="lazy"
          />
        </div>
        <div class="story-copy">
          <p class="eyebrow">Nos choix, vos histoires</p>
          <h2 id="story-title">Une maison qui vous ressemble.</h2>
          <p>Nous parcourons les ateliers et les maisons d’artisans à la recherche de belles matières, de gestes justes et d’objets faits pour durer.</p>
          <a class="text-link" href="#selection">L’esprit CECIL <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="newsletter" aria-labelledby="newsletter-title">
        <p class="eyebrow">Une lettre de temps en temps</p>
        <h2 id="newsletter-title">De belles choses, dans votre boîte mail.</h2>
        <p>Nos nouveautés, nos inspirations et les histoires derrière les objets.</p>
        <form class="newsletter-form" id="newsletter-form">
          <label class="sr-only" for="newsletter-email">Votre adresse e-mail</label>
          <input id="newsletter-email" type="email" placeholder="Votre adresse e-mail" required />
          <button type="submit" aria-label="S’inscrire à la lettre d’information">S’inscrire <span aria-hidden="true">↗</span></button>
        </form>
        <p class="newsletter-note" id="newsletter-note" aria-live="polite">Démo — aucune adresse n’est envoyée ni enregistrée.</p>
      </section>
    </main>

    <footer class="site-footer">
      <a class="wordmark footer-wordmark" href="#" aria-label="CECIL, accueil">CECIL<span>®</span></a>
      <p>De beaux objets, pour longtemps.</p>
      <div class="footer-links">
        <a href="#selection">La boutique</a>
        <a href="#histoire">À propos</a>
        <a href="mailto:bonjour@cecil.example">Contact</a>
      </div>
      <small>© 2026 CECIL — Boutique de démonstration</small>
    </footer>

    <div class="drawer-backdrop" id="drawer-backdrop" hidden></div>
    <aside class="cart-drawer" id="cart-drawer" aria-labelledby="cart-title" aria-hidden="true">
      <div class="drawer-header">
        <div>
          <p class="eyebrow">Votre sélection</p>
          <h2 id="cart-title">Votre panier <span id="drawer-count">(0)</span></h2>
        </div>
        <button class="icon-button" id="close-cart" type="button" aria-label="Fermer le panier">×</button>
      </div>
      <div class="cart-items" id="cart-items"></div>
      <div class="cart-footer" id="cart-footer">
        <div class="subtotal-row"><span>Sous-total</span><strong id="cart-subtotal">0 €</strong></div>
        <p>Livraison calculée à l’étape suivante. Offerte dès 120 €.</p>
        <button class="button checkout-button" type="button" disabled>Commande bientôt disponible</button>
      </div>
    </aside>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
  </body>
</html>
